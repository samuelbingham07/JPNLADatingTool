{
  "name": "garment-dater-ocr-bundle",
  "private": true,
  "type": "module",
  "description": "Bundles PaddleOCR (PP-OCRv4 via @gutenye/ocr-browser) for the static site. npm install && npm run build",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --platform=browser --external:fs --external:path --external:crypto --outfile=ocr.bundle.js"
  },
  "dependencies": {
    "@gutenye/ocr-browser": "1.4.9",
    "@gutenye/ocr-models": "1.4.2",
    "onnxruntime-web": "1.31.1",
    "@techstark/opencv-js": "4.12.0-release.1"
  },
  "devDependencies": { "esbuild": "0.28.2" },
  "overrides": { "onnxruntime-web": "1.31.1", "@techstark/opencv-js": "4.12.0-release.1" }
}
